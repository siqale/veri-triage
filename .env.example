# API Keys (Fallback / Default)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Azure AI Foundry (Multi-cloud Corporate Support)
AZURE_OPENAI_API_KEY=your_azure_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4
AZURE_OPENAI_API_VERSION=2023-05-15

# ==========================================
# GESTÃO DE AMBIENTE E SEGURANÇA
# ==========================================
ENVIRONMENT=dev
API_SECRET_KEY=sua_senha_secreta_aqui
FRONTEND_URL=http://localhost:5173

# ==========================================
# CONFIGURAÇÕES DO LANGCHAIN / LANGSMITH
# ==========================================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=veritriage
